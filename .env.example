# Copier en .env. Aucune variable n'est obligatoire pour la démo (npm run demo).

# Port d'écoute, toujours en loopback (nginx est le seul chemin d'entrée).
GARDIEN_PORT=8094

# Modèle utilisé par le chat.
GARDIEN_MODEL=claude-sonnet-5

# Authentification du Claude Agent SDK : une clé API Anthropic. Sans elle, le
# SDK reprend la session Claude Code ouverte sur la machine, s'il y en a une.
ANTHROPIC_API_KEY=

# Notifications : service de push du hub (endpoint interne en loopback) et son
# secret partagé. Laisser vide pour désactiver les notifications.
HUB_PUSH_URL=
INTERNAL_PUSH_TOKEN=

# Optionnel : autre emplacement pour la configuration de la machine et les données.
# GARDIEN_CONFIG=/etc/gardien/gardien.config.json
# GARDIEN_DATA_DIR=/var/lib/gardien
